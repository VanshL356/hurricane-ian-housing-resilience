  left_join(

    primary_predictions %>%

      select(
        County_ID,
        Pred_LM,
        Pred_ENet,
        Pred_RF,
        Pred_Ensemble,
        Unexpected_Resilience
      ),

    by = "County_ID"
  )


# ------------------------------------------------------------------------------
# 11. Florida-specific percentile
# ------------------------------------------------------------------------------

florida_percentiles <- resilience %>%

  filter(
    State == "FL"
  ) %>%

  mutate(

    Florida_Resilience_Percentile =
      100 *
      percent_rank(
        Resilience_Z
      )
  ) %>%

  select(
    County_ID,
    Florida_Resilience_Percentile
  )


ian_case <- ian_case %>%

  left_join(
    florida_percentiles,
    by = "County_ID"
  ) %>%

  arrange(
    Unexpected_Resilience
