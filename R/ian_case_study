# ==============================================================================
# 7. HELPER FUNCTION: FIT HOLDOUT ENSEMBLE
# ==============================================================================

fit_holdout_ensemble <- function(
    train_data,
    test_data,
    state_levels,
    seed = 123) {


  # --------------------------------------------------------------------------
  # Ensure train/test factors use identical levels
  # --------------------------------------------------------------------------

  train_data <- train_data %>%

    mutate(
      State = factor(
        as.character(State),
        levels = state_levels
      )
    )


  test_data <- test_data %>%

    mutate(
      State = factor(
        as.character(State),
        levels = state_levels
      )
    )


  # ==========================================================================
  # A. Linear regression
  # ==========================================================================

  lm_fit <- lm(
    prediction_formula,
    data = train_data
  )


  pred_lm <- predict(
    lm_fit,
    newdata = test_data
  )


  # ==========================================================================
  # B. Elastic net
  # ==========================================================================

  x_train <- model.matrix(
    prediction_formula,
    data = train_data
  )[, -1, drop = FALSE]


  x_test <- model.matrix(
    prediction_formula,
    data = test_data
  )[, -1, drop = FALSE]


  if (
    !identical(
      colnames(x_train),
      colnames(x_test)
    )
  ) {

    stop(
      "Elastic-net train and test matrices have different columns."
    )
  }


  y_train <- train_data$Resilience_Z


  alpha_grid <- c(
    0,
    0.25,
    0.50,
    0.75,
    1
  )


  # --------------------------------------------------------------------------
  # Stratified inner CV folds
  # --------------------------------------------------------------------------

  set.seed(seed)

  inner_foldid <- rep(
    NA_integer_,
    nrow(train_data)
  )


  for (state_value in state_levels) {

    state_index <- which(
      train_data$State == state_value
    )

    inner_foldid[state_index] <- sample(
      rep(
        1:5,
        length.out = length(state_index)
      )
    )
  }


  tuning_results <- list()


  for (alpha_value in alpha_grid) {

    cv_fit <- cv.glmnet(

      x = x_train,

      y = y_train,

      alpha = alpha_value,

      foldid = inner_foldid,

      type.measure = "mse",

      standardize = TRUE
    )


    best_index <- which.min(
      cv_fit$cvm
    )


    tuning_results[[
      length(tuning_results) + 1
    ]] <- data.frame(

      Alpha =
        alpha_value,

      Lambda =
        cv_fit$lambda[
          best_index
        ],

      CV_MSE =
        cv_fit$cvm[
          best_index
        ]
    )
  }


  tuning_results <- bind_rows(
    tuning_results
  )


  best_tuning <- tuning_results %>%

    arrange(
      CV_MSE
    ) %>%

    slice(1)


  enet_fit <- glmnet(

    x = x_train,

    y = y_train,

    alpha =
      best_tuning$Alpha,

    lambda =
      best_tuning$Lambda,

    standardize = TRUE
  )


  pred_enet <- as.numeric(

    predict(

      enet_fit,

      newx = x_test,

      s = best_tuning$Lambda
    )
  )


  # ==========================================================================
  # C. Random forest
  # ==========================================================================

  rf_fit <- ranger(

    formula =
      prediction_formula,

    data =
      train_data,

    num.trees =
      2000,

    mtry =
      4,

    min.node.size =
      5,

    seed =
      seed
  )


  pred_rf <- predict(

    rf_fit,

    data =
      test_data
  )$predictions


  # ==========================================================================
  # D. Ensemble
  # ==========================================================================

  predictions <- data.frame(

    County_ID =
      test_data$County_ID,

    Actual =
      test_data$Resilience_Z,

    Pred_LM =
      as.numeric(pred_lm),

    Pred_ENet =
      pred_enet,

    Pred_RF =
      as.numeric(pred_rf)
  ) %>%

    mutate(

      Pred_Ensemble =
        (
          Pred_LM +
          Pred_ENet +
          Pred_RF
        ) / 3,

      Unexpected_Resilience =
        Actual -
        Pred_Ensemble
    )


  return(

    list(

      predictions =
        predictions,

      tuning =
        tuning_results,

      best_tuning =
        best_tuning,

      lm_fit =
        lm_fit,

      enet_fit =
        enet_fit,

      rf_fit =
        rf_fit
    )
  )
}


