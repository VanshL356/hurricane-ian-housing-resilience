# ==============================================================================
# 13. CONTINUOUS DAMAGE ASSOCIATION
# ==============================================================================


# ------------------------------------------------------------------------------
# Spearman
# ------------------------------------------------------------------------------

spearman_test <- cor.test(

  ian_case$Log_Damage_Per_Capita,

  ian_case$Unexpected_Resilience,

  method = "spearman",

  exact = FALSE
)


# ------------------------------------------------------------------------------
# Pearson
# ------------------------------------------------------------------------------

pearson_test <- cor.test(

  ian_case$Log_Damage_Per_Capita,

  ian_case$Unexpected_Resilience,

  method = "pearson"
)


# ------------------------------------------------------------------------------
# OLS
# ------------------------------------------------------------------------------

damage_lm <- lm(

  Unexpected_Resilience ~
    Log_Damage_Per_Capita,

  data = ian_case
)


damage_lm_summary <- summary(
  damage_lm
)


damage_coef <- coef(
  damage_lm_summary
)


damage_association <- data.frame(

  Statistic = c(
    "Spearman rho",
    "Spearman p-value",
    "Pearson r",
    "Pearson p-value",
    "Pearson CI lower",
    "Pearson CI upper",
    "OLS damage coefficient",
    "OLS standard error",
    "OLS p-value",
    "OLS R-squared",
    "OLS adjusted R-squared"
  ),

  Value = c(

    unname(
      spearman_test$estimate
    ),

    spearman_test$p.value,

    unname(
      pearson_test$estimate
    ),

    pearson_test$p.value,

    pearson_test$conf.int[1],

    pearson_test$conf.int[2],

    damage_coef[
      "Log_Damage_Per_Capita",
      "Estimate"
    ],

    damage_coef[
      "Log_Damage_Per_Capita",
      "Std. Error"
    ],

    damage_coef[
      "Log_Damage_Per_Capita",
      "Pr(>|t|)"
    ],

    damage_lm_summary$r.squared,

    damage_lm_summary$adj.r.squared
  )
)


cat("\n========================================\n")
cat("DAMAGE ASSOCIATION\n")
cat("========================================\n")

print(
  damage_association
)


# ==============================================================================
# 14. EXPLORATORY SEVERE-DAMAGE COMPARISON
# ==============================================================================

ian_case <- ian_case %>%

  mutate(

    # Exploratory descriptive threshold
    Severe_Damage =
      Damage_Per_Capita >= 2000,

    Damage_Group =
      if_else(
        Severe_Damage,
        "Severe damage",
        "Other Ian-exposed"
      )
  )


severe_group_summary <- ian_case %>%

  group_by(
    Damage_Group
  ) %>%

  summarise(

    N =
      n(),

    Mean_Unexpected =
      mean(
        Unexpected_Resilience,
        na.rm = TRUE
      ),

    Median_Unexpected =
      median(
        Unexpected_Resilience,
        na.rm = TRUE
      ),

    SD_Unexpected =
      sd(
        Unexpected_Resilience,
        na.rm = TRUE
      ),

    .groups = "drop"
  )


wilcox_test <- wilcox.test(

  Unexpected_Resilience ~
    Severe_Damage,

  data =
    ian_case,

  exact =
    FALSE
)


severe_group_test <- data.frame(

  Test =
    "Wilcoxon rank-sum",

  Threshold =
    2000,

  Severe_N =
    sum(
      ian_case$Severe_Damage
    ),

  Other_N =
    sum(
      !ian_case$Severe_Damage
    ),

  W =
    unname(
      wilcox_test$statistic
    ),

  P_Value =
    wilcox_test$p.value
)


cat("\n========================================\n")
cat("SEVERE-DAMAGE GROUP SUMMARY\n")
cat("========================================\n")

print(
  severe_group_summary
)


cat("\nExploratory Wilcoxon test:\n")

print(
  severe_group_test
)


# ==============================================================================
# 15. LEAVE-ONE-COUNTY-OUT DAMAGE REGRESSIONS
# ==============================================================================

leave_one_out_results <- lapply(

  ian_case$County_ID,

  function(county_to_remove) {

    loo_data <- ian_case %>%

      filter(
        County_ID != county_to_remove
      )


    fit <- lm(

      Unexpected_Resilience ~
        Log_Damage_Per_Capita,

      data =
        loo_data
    )


    fit_summary <- summary(
      fit
    )


    coef_table <- coef(
      fit_summary
    )


    removed_name <- ian_case %>%

      filter(
        County_ID == county_to_remove
      ) %>%

      pull(
        County
      )


    data.frame(

      Removed_County =
        removed_name,

      Damage_Beta =
        coef_table[
          "Log_Damage_Per_Capita",
          "Estimate"
        ],

      Standard_Error =
        coef_table[
          "Log_Damage_Per_Capita",
          "Std. Error"
        ],

      P_Value =
        coef_table[
          "Log_Damage_Per_Capita",
          "Pr(>|t|)"
        ],

      R_Squared =
        fit_summary$r.squared
    )
  }
) %>%

  bind_rows()


cat("\n========================================\n")
cat("LEAVE-ONE-OUT STABILITY\n")
cat("========================================\n")

cat(
  "Negative coefficients:",
  sum(
    leave_one_out_results$Damage_Beta < 0
  ),
  "of",
  nrow(leave_one_out_results),
  "\n"
)


